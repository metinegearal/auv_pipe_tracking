<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pipe_track_bringup</name>
  <version>1.0.0</version>
  <description>Bringup package for the AUV pipe tracking system, containing launch and config files.</description>
  <maintainer email="metinegearal@gmail.com">metin-ege</maintainer>
  <license>MIT</license>

  <exec_depend>pipe_track_control</exec_depend>
  <exec_depend>pipe_track_perception</exec_depend>
  <exec_depend>pipe_track_planning</exec_depend>
  <exec_depend>pipe_track_sim</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>