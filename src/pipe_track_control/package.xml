<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pipe_track_control</name>
  <version>1.0.0</version>
  
  <description>
    Waypoint-based PID control system for AUV pipe tracking using SE(3) manifold geometry and visual segmentation.
  </description>
  
  <maintainer email="metin-ege@example.com">Metin Ege</maintainer>
  
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Node Dependencies (The libraries your C++ code actually `#include`s) -->
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>